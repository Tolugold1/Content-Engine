# Copy to `.env` (Docker / worker) and `apps/web/.env.local` (local dashboard), then fill in.
# Every key is explained in docs/SETUP.md. Empty values mean "not configured": that feature is skipped.

# --- App ---------------------------------------------------------------------
# Public https URL of the dashboard (used for Telegram buttons and the webhook).
APP_URL=http://localhost:3000
# Domain Caddy should get a certificate for (production only), e.g. studio.example.com
DOMAIN=
DASHBOARD_TIMEZONE=Africa/Lagos
WORKER_PORT=3001

# --- Database and sign-in: Supabase ---------------------------------------------
SUPABASE_URL=
# Publishable ("anon") key: used for sign-in sessions.
SUPABASE_ANON_KEY=
# Secret service-role key: server-side data access and creating the owner account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in: only this email can sign up and sign in --------------------------
OWNER_EMAIL=
# One-time code needed to create the owner account: `openssl rand -hex 16`.
# Sign-up closes once the account exists; you can remove this afterwards.
SIGNUP_CODE=

# --- Workflows: Inngest -----------------------------------------------------------
# Local development: run `npx inngest-cli@latest dev -u http://localhost:3001/api/inngest` and set INNGEST_DEV=1.
INNGEST_DEV=
# Production (self-hosted in docker-compose): generate both with `openssl rand -hex 32`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set automatically in docker-compose; for local dev with the dev server use http://localhost:8288
INNGEST_BASE_URL=

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Voice: ElevenLabs ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Storage: Cloudflare R2 ------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string: `openssl rand -hex 24`
TELEGRAM_WEBHOOK_SECRET=

# --- Trend sources (optional; each one is skipped when empty) ---------------------
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
FOOTBALL_DATA_API_KEY=

# --- Rendering (optional) -------------------------------------------------------
# Path to Chrome/Chromium; leave empty to let Remotion download its own headless shell.
REMOTION_BROWSER_EXECUTABLE=
# Only needed if you render for a company of more than three people (Remotion licence).
REMOTION_LICENSE_KEY=
